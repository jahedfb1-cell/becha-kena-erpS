## Production .env template for Hostinger deployment.
## Copy this to `.env` on the server and fill in the placeholders below.
## Never commit the real `.env` file — only this template goes to GitHub.

APP_NAME="Dhaka Blinds ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dhakablinds.shop

# The React frontend's public URL. If frontend and backend share one domain
# with the backend on a subpath (e.g. dhakablinds.shop/api), set this to the
# root domain. If using separate subdomains (recommended), set this to the
# frontend's subdomain (e.g. https://app.dhakablinds.shop).
FRONTEND_URL=https://dhakablinds.shop

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database: fill in from Hostinger hPanel > Databases > MySQL Databases ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

# --- Mail: Hostinger email account SMTP (same pattern as local admin@dhakablinds.shop) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=admin@dhakablinds.shop
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admin@dhakablinds.shop
MAIL_FROM_NAME="Dhaka Blinds ERP"
